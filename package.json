{
  "name": "agentos-platform",
  "private": true,
  "version": "0.40.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "generate": "ci/generate-controller.sh && buf generate --template contracts/buf.gen.yaml && buf generate --template contracts/buf.errors.gen.yaml && node contracts/generate-management.mjs && tsx contracts/generate-permissions.ts",
    "dev": "vite --host 127.0.0.1",
    "server": "tsx watch server/apps/api.ts",
    "build": "npm run generate && vite build && tsc --project server/tsconfig.json",
    "check": "buf lint proto && biome check . && tsc --noEmit && knip",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify": "npm run build && npm run check && npm test"
  },
  "dependencies": {
