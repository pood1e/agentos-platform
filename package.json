{
  "name": "agentos-platform",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "generate": "ci/tools.sh jsonschema && buf generate && buf generate --template buf.errors.gen.yaml && node scripts/generate-management.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:kagent": "tsx tests/fake-kagent/server.ts",
    "server": "tsx watch server/platform/main.ts",
    "start": "node build/server/platform/main.js",
    "build": "npm run generate && vite build && tsc --project tsconfig.server.json",
    "check": "buf lint proto && biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "ci/tools.sh fga openfga && vitest run",
    "test:authorization": "ci/verify-authorization.sh",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm run check && npm test"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.28",
    "@assistant-ui/react-markdown": "0.14.21",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-fastify": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.2.0",
    "@connectrpc/validate": "0.2.0",
    "@fastify/static": "10.1.6",
    "@fontsource-variable/geist": "5.3.0",
    "@kubernetes/client-node": "2.0.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@openfga/sdk": "0.9.7",
    "@rjsf/core": "6.11.0",
    "@rjsf/shadcn": "6.11.0",
    "@rjsf/utils": "6.11.0",
    "@rjsf/validator-ajv8": "6.11.0",
    "@tanstack/react-query": "5.104.2",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "async-mutex": "0.5.0",
    "canonicalize": "5.1.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "d3-dag": "1.2.2",
    "elkjs": "0.12.0",
    "entities": "8.1.0",
    "fastify": "5.12.5",
    "i18next": "26.4.4",
    "i18next-browser-languagedetector": "8.2.1",
    "isomorphic-git": "1.44.2",
    "jose": "6.2.13",
    "lru-cache": "11.5.3",
    "lucide-react": "1.55.0",
    "next-themes": "0.4.6",
    "openai": "7.32.0",
    "parse5": "8.0.1",
    "postgres": "3.4.9",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-diff-viewer-continued": "4.4.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "vis-timeline": "8.5.4",
    "yaml": "2.9.1",
    "openid-client": "6.8.8"
  },
  "overrides": {
    "@openfga/sdk": {
      "axios": "1.20.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@keycloak/keycloak-admin-client": "26.8.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "undici": "8.12.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
