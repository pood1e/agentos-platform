apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayParameters
metadata: {name: mcp-gateway, namespace: {{ gateway_namespace }}}
spec:
  image:
    registry: cr.agentgateway.dev
    repository: agentgateway
    tag: v1.6.0
    digest: sha256:9d3e6044ddcdc0878b1787f77bd401252b95e22684203fb5e874c4c42d2ed90c
  resources:
    requests: {cpu: 100m, memory: 128Mi}
    limits: {memory: 512Mi}
  logging: {format: json, level: info}
  service:
    spec:
      type: NodePort
      externalTrafficPolicy: Local
      ports:
        - {name: https, port: 8443, targetPort: 8443, nodePort: {{ gateway_node_port }}, protocol: TCP}
  deployment:
    spec:
      replicas: 1
      template:
        metadata:
          labels: {agentos.dev/gateway: environment}
        spec:
          securityContext:
            runAsNonRoot: true
            seccompProfile: {type: RuntimeDefault}
          containers:
            - name: agentgateway
              securityContext:
                allowPrivilegeEscalation: false
                readOnlyRootFilesystem: true
                capabilities: {drop: [ALL]}
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: mcp-gateway
  namespace: {{ gateway_namespace }}
  labels: {agentos.dev/environment: {{ environment_name }}}
spec:
  gatewayClassName: agentgateway
  infrastructure:
    parametersRef: {group: agentgateway.dev, kind: AgentgatewayParameters, name: mcp-gateway}
  listeners:
    - name: https
      port: 8443
      protocol: HTTPS
      tls:
        mode: Terminate
        certificateRefs: [{name: mcp-gateway-tls}]
      allowedRoutes:
        namespaces: {from: Same}
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata: {name: gateway-auth, namespace: {{ gateway_namespace }}}
spec:
  targetRefs:
    - {group: gateway.networking.k8s.io, kind: Gateway, name: mcp-gateway}
  frontend:
    http: {maxBufferSize: 16Mi}
  traffic:
    jwtAuthentication:
      mode: Strict
      preserveToken: true
      providers:
        - issuer: {{ environment_issuer | to_json }}
          audiences: [{{ gateway_resource | to_json }}]
          jwks: {remote: {url: {{ environment_discovery.json.jwks_uri | to_json }}}}
          validation: {requiredClaims: [sub, exp, aud]}
      mcp:
        provider: Keycloak
        resourceMetadata:
          resource: {{ gateway_resource | to_json }}
          authorization_servers: [{{ environment_issuer | to_json }}]
          bearer_methods_supported: [header]
    authorization:
      action: Require
      policy:
        matchExpressions:
          - >-
            request.path.startsWith('/.well-known/') ||
            (has(jwt.azp) && jwt.azp in {{ engineer_identities | map(attribute='name') | map('regex_replace', '^', 'agentos-') | list | to_json }})
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata: {name: environment-mcp-handshake, namespace: {{ gateway_namespace }}}
spec:
  targetRefs:
    - {group: gateway.networking.k8s.io, kind: Gateway, name: mcp-gateway}
  traffic:
    directResponse:
      conditional:
        - condition: >-
            request.path.startsWith('/mcp/') &&
            'mcp-method' in request.headers && request.headers['mcp-method'] == 'server/discover'
          policy:
            status: 404
            body: 'Use initialize.'
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata: {name: mcp-oauth-metadata, namespace: {{ gateway_namespace }}}
spec:
  parentRefs: [{name: mcp-gateway, sectionName: https}]
  rules:
    - matches:
        - path: {type: PathPrefix, value: /.well-known/oauth-protected-resource/mcp}
        - path: {type: PathPrefix, value: /.well-known/oauth-authorization-server/mcp}
      backendRefs:
        - {group: agentgateway.dev, kind: AgentgatewayBackend, name: {{ toolsets.keys() | first }}-catalog}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: gateway-ingress, namespace: {{ gateway_namespace }}}
spec:
  podSelector:
    matchLabels: {agentos.dev/gateway: environment}
  policyTypes: [Ingress]
  ingress:
    - from:
        - ipBlock: {cidr: {{ platform_cidr }}}
      ports: [{port: 8443, protocol: TCP}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: mcp-backends, namespace: {{ gateway_namespace }}}
spec:
  podSelector:
    matchLabels: {agentos.dev/component: mcp-server}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels: {agentos.dev/gateway: environment}
