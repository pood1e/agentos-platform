{% set servers = [] %}
{% if environment_state == 'present' %}
{% for project, tools in toolsets.items() %}
{% set name = environment_name + '-' + project %}
{% set unused = servers.append(name) %}
{% for identity in engineer_identities if identity.name != 'catalog' and project in identity.services %}
{% set profile = name + '-' + identity.name %}
{% set unused = servers.append(profile) %}
{% set writes = tools.write | default([]) + (tools.management | default([]) if identity.services[project] == 'manage' else []) %}
{% if identity.services[project] in ['operate', 'manage'] and writes %}
{% set unused = servers.append(profile + '-changes') %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{{ servers | to_json }}
