{% for identity in engineer_identities %}
{% for project, tools in toolsets.items() if project in identity.services %}
{% set access = identity.services[project] %}
{% set writes = tools.write | default([]) + (tools.management | default([]) if access == 'manage' else []) %}
{% set reads = tools.readOnly | default([]) + (tools.managementReadOnly | default([]) if access == 'manage' else []) %}
{% set allowed = reads + (writes if access in ['operate', 'manage'] else []) %}
{% set backend = project + '-' + identity.name %}
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayBackend
metadata:
  name: {{ backend }}
  namespace: {{ gateway_namespace }}
  labels: {agentos.dev/component: environment-tool, agentos.dev/project: {{ project }}}
spec:
  mcp:
    prefixMode: Never
    sessionRouting: Stateless
    targets:
{% for target in environment_connectors[project].targets if target.access is not defined or access in target.access %}
      - name: {{ target.name | default(project) }}
        static:
          host: {{ target.host }}
          port: {{ target.port }}
{% if target.path is defined %}
          path: {{ target.path }}
{% endif %}
          protocol: {{ target.protocol | default('StreamableHTTP') }}
{% set authentication = target.auth | default({}) %}
{% if authentication %}
          policies:
            auth: {{ authentication | to_json | replace('<identity>', identity.name) | replace('<environment>', environment_name) | replace('<issuer>', environment_issuer) }}
{% endif %}
{% endfor %}
  policies:
    mcp:
      authorization:
        action: Require
        policy:
          matchExpressions:
            - {{ ('mcp.tool.name in ' + (allowed | to_json)) | to_json }}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata: {name: {{ backend }}, namespace: {{ gateway_namespace }}}
spec:
  parentRefs: [{name: mcp-gateway, sectionName: https}]
  rules:
    - matches:
        - path: {type: Exact, value: /mcp/{{ identity.name }}/{{ project }}}
      filters:
        - type: RequestHeaderModifier
          requestHeaderModifier:
{% if environment_connectors[project].targets | selectattr('auth', 'defined') | map(attribute='auth') | selectattr('oauthTokenExchange', 'defined') | list | length == 0 %}
            remove: [x-substrate-actor-token, authorization]
{% else %}
            remove: [x-substrate-actor-token]
{% endif %}
      backendRefs:
        - {group: agentgateway.dev, kind: AgentgatewayBackend, name: {{ backend }}}
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata: {name: {{ backend }}-identity, namespace: {{ gateway_namespace }}}
spec:
  targetRefs:
    - {group: gateway.networking.k8s.io, kind: HTTPRoute, name: {{ backend }}}
  traffic:
    authorization:
      action: Require
      policy:
        matchExpressions: ["has(jwt.azp) && jwt.azp == 'agentos-{{ identity.name }}'"]
{% endfor %}
{% endfor %}
