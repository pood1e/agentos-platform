{% for identity in engineer_identities %}
{% for project, tools in toolsets.items() if project in identity.services %}
{% set access = identity.services[project] %}
{% set writes = tools.write | default([]) + (tools.management | default([]) if access == 'manage' else []) %}
{% set reads = tools.readOnly | default([]) + (tools.managementReadOnly | default([]) if access == 'manage' else []) %}
{% set allowed = reads + (writes if access in ['operate', 'manage'] else []) %}
{% set delegated = identity.name != 'catalog' and environment_connectors[project].targets | selectattr('userAuth', 'defined') | list | length > 0 %}
{% for execution_kind in (['service', 'user'] if delegated else ['service']) %}
{% set backend = project + '-' + identity.name + ('-user' if execution_kind == 'user' else '') %}
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayBackend
metadata:
  name: {{ backend }}
  namespace: {{ gateway_namespace }}
  labels: {agentos.dev/component: environment-tool, agentos.dev/project: {{ project }}}
spec:
  mcp:
    prefixMode: Never
{% if delegated %}
    sessionRouting: Stateless
{% endif %}
    targets:
{% for target in environment_connectors[project].targets if target.access is not defined or access in target.access %}
      - name: {{ target.name | default(project) }}
        static:
          host: {{ target.host }}
          port: {{ target.port }}
{% if target.path is defined %}
          path: {{ target.path }}
{% endif %}
          protocol: {{ target.protocol | default('StreamableHTTP') }}
{% set authentication = target.userAuth | default(target.auth | default({})) if execution_kind == 'user' else target.auth | default({}) %}
{% if authentication %}
          policies:
            auth: {{ authentication | to_json | replace('<identity>', identity.name) | replace('<environment>', environment_name) }}
{% endif %}
{% endfor %}
  policies:
    mcp:
      authorization:
        action: Require
        policy:
          matchExpressions:
            - {{ ('mcp.tool.name in ' + (allowed | to_json)) | to_json }}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata: {name: {{ backend }}, namespace: {{ gateway_namespace }}}
spec:
  parentRefs: [{name: mcp-gateway, sectionName: http}]
  rules:
    - matches:
        - path: {type: PathPrefix, value: /mcp/{{ project }}}
          headers:
            - {name: x-agentos-engineer, type: Exact, value: {{ identity.name }}}
{% if delegated %}
            - {name: x-agentos-execution-kind, type: Exact, value: {{ execution_kind }}}
{% endif %}
      backendRefs:
        - {group: agentgateway.dev, kind: AgentgatewayBackend, name: {{ backend }}}
{% endfor %}
{% endfor %}
{% endfor %}
