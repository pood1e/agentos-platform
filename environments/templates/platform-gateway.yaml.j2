{% for service in service_resources.resources if service.metadata.labels['agentos.dev/project'] in toolsets %}
{% set name = service.metadata.name %}
{% set project = service.metadata.labels['agentos.dev/project'] %}
{% set owner = {'apiVersion': 'agentgateway.dev/v1alpha1', 'kind': 'AgentgatewayBackend', 'name': name, 'uid': service.metadata.uid} %}
{% for identity in engineer_identities if identity.name != 'catalog' and project in identity.services %}
{% set access = identity.services[project] %}
{% set writes = toolsets[project].write | default([]) + (toolsets[project].management | default([]) if access == 'manage' else []) %}
{% set reads = toolsets[project].readOnly | default([]) + (toolsets[project].managementReadOnly | default([]) if access == 'manage' else []) %}
{% for view in ['readOnly', 'write'] if view == 'readOnly' or (access in ['operate', 'manage'] and writes) %}
{% set selected_tools = reads if view == 'readOnly' else writes %}
{% set profile = name + '-' + identity.name + ('-changes' if view == 'write' else '') %}
{% set route_path = '/mcp/' + name + '/' + identity.name + ('/changes' if view == 'write' else '/readonly') %}
{% set target = service.spec.mcp.targets[0].static %}
{% set policies = service.spec.policies | default({}) | combine(target.policies | default({})) %}
{% set policies = policies | dict2items | rejectattr('key', 'in', ['auth', 'mcp']) | items2dict %}
{% set target = target | combine({'path': '/mcp/' + identity.name + '/' + project}) %}
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayBackend
metadata:
  name: {{ profile }}
  namespace: {{ agentos_namespace }}
  labels: {agentos.dev/environment: {{ environment_name }}, agentos.dev/engineer: {{ identity.name }}, agentos.dev/access: engineer, agentos.dev/tool-access: {{ view }}}
  ownerReferences: [{{ owner | to_json }}]
spec:
  mcp:
    prefixMode: Always
    targets:
      - name: {{ name }}
        static: {{ target | combine({'policies': policies}) | to_json }}
  policies:
    mcp:
      guardrails:
        processors:
          - methods: {'*': Full}
            remote:
              backendRef: {name: {{ platform_release }}-console, port: 9090}
              failureMode: FailClosed
              allowedRequestHeaders: [x-substrate-actor-token]
              metadata: {execution: 'true', environment: "'{{ environment_name }}'", identity: "'{{ identity.name }}'"}
      authorization:
        action: Require
        policy:
          matchExpressions:
            - {{ ('mcp.tool.name in ' + (selected_tools | to_json)) | to_json }}
---
apiVersion: api.kagent.dev/v1alpha3
kind: RemoteMCPServer
metadata:
  name: {{ profile }}
  namespace: {{ agentos_namespace }}
  annotations: {agentos.dev/discovery-auth: kubernetes}
  labels: {agentos.dev/environment: {{ environment_name }}, agentos.dev/engineer: {{ identity.name }}, agentos.dev/toolset-revision: '{{ toolset_revision }}'}
  ownerReferences: [{{ owner | to_json }}]
spec:
  description: {{ (service.metadata.annotations['agentos.dev/display-name'] | default(name) + '; ' + identity.name) | to_json }}
  protocol: STREAMABLE_HTTP
  url: http://{{ platform_release }}-mcp-gateway.{{ agentos_namespace }}.svc.cluster.local:8080{{ route_path }}
  timeout: 10m
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: mcp-{{ profile }}
  namespace: {{ agentos_namespace }}
  labels: {agentos.dev/mcp-source: '{{ service.metadata.uid }}'}
  ownerReferences: [{{ owner | to_json }}]
spec:
  parentRefs: [{name: {{ platform_gateway }}, sectionName: http}]
  rules:
    - matches:
        - path: {type: PathPrefix, value: {{ route_path }}}
      backendRefs: [{group: agentgateway.dev, kind: AgentgatewayBackend, name: {{ profile }}}]
{% endfor %}
{% endfor %}
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: {{ name }}-runtime-auth
  namespace: {{ agentos_namespace }}
  ownerReferences: [{{ owner | to_json }}]
spec:
  targetSelectors:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      matchLabels: {agentos.dev/mcp-source: '{{ service.metadata.uid }}'}
  traffic:
    jwtAuthentication:
      mode: Strict
      preserveToken: true
      location:
        expression: >-
          'x-substrate-actor-token' in request.headers ? request.headers['x-substrate-actor-token'].replace('Bearer ', '') :
          ('authorization' in request.headers ? request.headers['authorization'].replace('Bearer ', '') : '')
      providers:
        - issuer: {{ platform_actor_issuer | to_json }}
          audiences: {{ platform_actor_audiences | to_json }}
          jwks: {inline: {{ platform_actor_jwks | to_json | to_json }}}
          validation: {requiredClaims: [sub, exp, aud]}
        - issuer: {{ platform_discovery_issuer | to_json }}
          audiences: [agentos-mcp-discovery]
          jwks: {inline: {{ platform_discovery_jwks | to_json | to_json }}}
          validation: {requiredClaims: [sub, exp, aud]}
    authorization:
      action: Require
      policy:
        matchExpressions:
          - >-
            (request.path != '/mcp/{{ name }}' && jwt.iss == '{{ platform_actor_issuer }}') ||
            (jwt.iss == '{{ platform_discovery_issuer }}' && jwt.sub == 'system:serviceaccount:{{ agentos_namespace }}:{{ native_controller_service_account }}')
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: mcp-{{ name }}
  namespace: {{ agentos_namespace }}
  labels: {agentos.dev/mcp-source: '{{ service.metadata.uid }}'}
  ownerReferences: [{{ owner | to_json }}]
spec:
  parentRefs: [{name: {{ platform_gateway }}, sectionName: http}]
  rules:
    - matches: [{path: {type: PathPrefix, value: /mcp/{{ name }}}}]
      backendRefs: [{group: agentgateway.dev, kind: AgentgatewayBackend, name: {{ name }}}]
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: {{ name }}-engineer-auth
  namespace: {{ agentos_namespace }}
  ownerReferences: [{{ owner | to_json }}]
spec:
  targetRefs:
    - {group: gateway.networking.k8s.io, kind: HTTPRoute, name: mcp-{{ name }}}
  backend:
    mcp:
      authorization:
        action: Require
        policy:
          matchExpressions:
            - {{ ('mcp.tool.name in ' + (toolsets[project].readOnly | default([]) | to_json)) | to_json }}
{% endfor %}
