{% from 'transport-auth.yaml.j2' import transport_auth with context %}
{% for project in toolsets %}
{% set name = environment_name + '-' + project %}
{% if name not in existing_services %}
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayBackend
metadata:
  name: {{ name }}
  namespace: {{ agentos_namespace }}
  annotations:
    agentos.dev/system-connection: 'false'
    agentos.dev/display-name: {{ environment_connectors[project].title | default(project) | to_json }}
  labels: {agentos.dev/environment: {{ environment_name }}, agentos.dev/project: {{ project }}, agentos.dev/governance: {{ environment_governance }}}
spec:
  mcp:
    prefixMode: Always
    targets:
      - name: {{ name }}
        static:
          host: {{ ansible_host }}
          port: {{ gateway_node_port }}
          path: /mcp/catalog/{{ project }}
          protocol: StreamableHTTP
  policies:
    extAuth: {{ transport_auth(name, 'catalog') }}
    http: {requestTimeout: 10m}
    tls:
      sni: {{ gateway_server_name | to_json }}
      caCertificateRefs: [{name: {{ environment_name }}-gateway-ca, kind: ConfigMap}]
      verifySubjectAltNames: [{{ gateway_server_name | to_json }}]
    mcp:
      guardrails:
        processors:
          - methods: {'*': Full}
            remote:
              backendRef: {name: {{ platform_release }}-console, port: 9090}
              failureMode: FailClosed
              allowedRequestHeaders: [x-substrate-actor-token]
              metadata: {execution: 'true', environment: "'{{ environment_name }}'", identity: "'catalog'"}
{% endif %}
{% endfor %}
