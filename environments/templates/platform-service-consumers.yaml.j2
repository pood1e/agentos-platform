{% for service in service_resources.resources if service.metadata.labels['agentos.dev/project'] in toolsets %}
{% set name = service.metadata.name %}
---
apiVersion: api.kagent.dev/v1alpha3
kind: RemoteMCPServer
metadata:
  name: {{ name }}
  namespace: {{ agentos_namespace }}
  labels: {agentos.dev/environment: {{ environment_name }}, agentos.dev/toolset-revision: '{{ toolset_revision }}'}
  ownerReferences:
    - {apiVersion: agentgateway.dev/v1alpha1, kind: AgentgatewayBackend, name: {{ name }}, uid: {{ service.metadata.uid }}}
spec:
  description: {{ service.metadata.annotations['agentos.dev/display-name'] | default(name) | to_json }}
  protocol: STREAMABLE_HTTP
  url: http://{{ name }}-mcp-gateway.{{ agentos_namespace }}.svc.cluster.local:8080/mcp/{{ name }}
  timeout: 10m
  headersFrom:
    - name: Authorization
      valueFrom: {type: Secret, name: {{ platform_gateway }}, key: authorization}
{% endfor %}
