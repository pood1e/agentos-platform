apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ environment_name }}-engineer-keys
  namespace: {{ agentos_namespace }}
  labels: {agentos.dev/gateway-keys: {{ platform_release }}}
data:
{% for identity in engineer_identities %}
  {{ environment_name }}-{{ identity.name }}: {{ {'keyHash': 'sha256:' + (gateway_credentials[identity.name] | hash('sha256')), 'metadata': {'engineer': identity.name, 'environment': environment_name, 'services': identity.services}} | to_json | to_json }}
{% endfor %}
{% for identity in engineer_identities %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ environment_name }}-{{ identity.name }}
  namespace: {{ agentos_namespace }}
type: Opaque
data:
  authorization: {{ ('Bearer ' + gateway_credentials[identity.name]) | b64encode }}
  gateway: {{ gateway_credentials[identity.name] | b64encode }}
  engineer: {{ identity.name | b64encode }}
{% endfor %}
