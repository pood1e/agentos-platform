@@ -0,0 +1,16 @@
+package utils
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/kagent-dev/kagent/go/core/pkg/env"
+)
+
+// GetRuntimeAPIURL selects the controller-owned runtime API endpoint.
+func GetRuntimeAPIURL() string {
+	if value := env.KagentAPIURL.Get(); value != "" {
+		return strings.TrimRight(value, "/")
+	}
+	return fmt.Sprintf("http://%s.%s:8083", GetControllerName(), GetResourceNamespace())
+}
--- /dev/null
+++ b/go/core/internal/utils/runtime_api_test.go
@@ -0,0 +1,14 @@
+package utils
+
+import (
+	"testing"
+
+	"github.com/kagent-dev/kagent/go/core/pkg/env"
+)
+
+func TestRuntimeAPIURL(t *testing.T) {
+	t.Setenv(env.KagentAPIURL.Name(), "http://runtime-gateway.work.svc:9091/")
+	if got := GetRuntimeAPIURL(); got != "http://runtime-gateway.work.svc:9091" {
+		t.Fatalf("runtime URL = %q", got)
+	}
+}
