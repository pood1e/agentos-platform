+	require.ErrorIs(t, client.DeleteMemoryEntry(ctx, "other-agent", "owner", first.ID), ErrNotFound)
+	require.NoError(t, client.DeleteMemoryEntry(ctx, "team-a/my-agent", "owner", first.ID))
