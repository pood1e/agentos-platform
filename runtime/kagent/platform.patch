index 0000000..4eaa2b4
--- /dev/null
+++ b/go/core/internal/service/tool/discovery_auth.go
@@ -0,0 +1,40 @@
+package tool
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+
+	"k8s.io/client-go/transport"
+
+	"github.com/kagent-dev/kagent/go/api/v1alpha3"
+)
+
+// Projected credentials are restricted to the operator-configured platform origin.
+func discoveryHTTPClient(server *v1alpha3.RemoteMCPServer, base *http.Client) (*http.Client, error) {
+	if server.Annotations["agentos.dev/discovery-auth"] != "kubernetes" {
+		return base, nil
+	}
+	origin, err := url.Parse(os.Getenv("KAGENT_MCP_DISCOVERY_URL"))
+	if err != nil || origin.Host == "" {
+		return nil, fmt.Errorf("MCP discovery origin is unavailable")
+	}
+	target, err := url.Parse(server.Spec.URL)
+	if err != nil || target.User != nil || target.Scheme != origin.Scheme || target.Host != origin.Host || !strings.HasPrefix(target.Path, "/mcp/") {
+		return nil, fmt.Errorf("MCP discovery target is outside the platform origin")
+	}
+	tokenFile := os.Getenv("KAGENT_MCP_DISCOVERY_TOKEN_FILE")
+	if tokenFile == "" {
+		return nil, fmt.Errorf("MCP discovery token file is unavailable")
+	}
+	roundTripper, err := transport.NewBearerAuthWithRefreshRoundTripper("", tokenFile, base.Transport)
+	if err != nil {
+		return nil, fmt.Errorf("load MCP discovery token: %w", err)
+	}
+	result := *base
+	result.Transport = roundTripper
+	result.CheckRedirect = func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }
+	return &result, nil
+}
