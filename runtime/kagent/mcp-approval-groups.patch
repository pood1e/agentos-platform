diff --git a/go/core/internal/translator/mcp_bindings.go b/go/core/internal/translator/mcp_bindings.go
new file mode 100644
index 00000000..ece94331
--- /dev/null
+++ b/go/core/internal/translator/mcp_bindings.go
@@ -0,0 +1,37 @@
+package translator
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+)
+
+// MCPBindingNames gives each approval group a native identity with an exact tool scope.
+func MCPBindingNames(tools []ResolvedMCPTool) ([]string, error) {
+	names := make([]string, len(tools))
+	for i, tool := range tools {
+		if tool.Server == nil {
+			return nil, fmt.Errorf("resolved MCP binding has no server")
+		}
+		name := strings.ReplaceAll(tool.Server.Name, ".", "_")
+		if tool.Binding.RequireApproval {
+			name += "-approval"
+		}
+		names[i] = name
+		for _, previous := range tools[:i] {
+			if previous.Server.Namespace != tool.Server.Namespace || previous.Server.Name != tool.Server.Name ||
+				previous.Binding.RequireApproval == tool.Binding.RequireApproval {
+				continue
+			}
+			if len(previous.Binding.Tools) == 0 || len(tool.Binding.Tools) == 0 {
+				return nil, NewValidationError("mixed approval groups for RemoteMCPServer %q require explicit tool selections", tool.Server.Name)
+			}
+			for _, selected := range tool.Binding.Tools {
+				if slices.Contains(previous.Binding.Tools, selected) {
+					return nil, NewValidationError("RemoteMCPServer %q tool %q has conflicting approval requirements", tool.Server.Name, selected)
+				}
+			}
+		}
+	}
+	return names, nil
+}
diff --git a/go/core/internal/translator/mcp_bindings_test.go b/go/core/internal/translator/mcp_bindings_test.go
new file mode 100644
index 00000000..b907c869
--- /dev/null
+++ b/go/core/internal/translator/mcp_bindings_test.go
@@ -0,0 +1,21 @@
+package translator
+
+import (
+	"testing"
+
+	"github.com/kagent-dev/kagent/go/api/v1alpha3"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func TestMCPBindingNamesRejectConflictingApprovalScopes(t *testing.T) {
+	server := &v1alpha3.RemoteMCPServer{ObjectMeta: metav1.ObjectMeta{Name: "tools", Namespace: "test"}}
+	for _, selected := range [][]string{nil, {"execute"}} {
+		bindings := []ResolvedMCPTool{
+			{Server: server, Binding: v1alpha3.MCPToolBinding{Tools: selected}},
+			{Server: server, Binding: v1alpha3.MCPToolBinding{Tools: []string{"execute"}, RequireApproval: true}},
+		}
+		if _, err := MCPBindingNames(bindings); err == nil {
+			t.Errorf("MCPBindingNames(%v) accepted conflicting approval scopes", selected)
+		}
+	}
+}
