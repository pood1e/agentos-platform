@@ -0,0 +1,25 @@
+package controllerclient
+
+import (
+	"testing"
+	"time"
+
+	apia2a "github.com/kagent-dev/kagent/go/api/a2a"
+	"google.golang.org/grpc/metadata"
+)
+
+func TestCallContextRequestsHostActorCredential(t *testing.T) {
+	client := &Client{timeout: -time.Second}
+	original := metadata.NewOutgoingContext(t.Context(), metadata.Pairs(apia2a.ActorTokenHeader, "forged"))
+	ctx, cancel := client.CallContext(original, "")
+	defer cancel()
+	headers, _ := metadata.FromOutgoingContext(ctx)
+	values := headers.Get(apia2a.ActorTokenHeader)
+	if len(values) != 1 || values[0] != "required" {
+		t.Fatalf("actor placeholder = %q", values)
+	}
+	previous, _ := metadata.FromOutgoingContext(original)
+	if previous.Get(apia2a.ActorTokenHeader)[0] != "forged" {
+		t.Fatal("caller context was mutated")
+	}
+}
