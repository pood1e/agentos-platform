+	if _, err := uuid.Parse(id); err != nil || agentName == "" || userID == "" {
+		return serviceerrors.NewInvalidArgument("A memory ID, agent name and user ID are required", nil)
+	}
+	session, ok := auth.AuthSessionFrom(ctx)
+	if !ok {
+		return serviceerrors.NewUnauthenticated("A caller identity is required", nil)
+	}
+	if session.Principal().User.ID != userID {
+		return serviceerrors.NewPermissionDenied("Memory belongs to another user", nil)
+	}
+	if s.store == nil {
+		return serviceerrors.NewInternal("failed to delete memory entry", fmt.Errorf("database client is not configured"))
+	}
+	if err := s.store.DeleteMemoryEntry(ctx, agentName, userID, id); err != nil {
+		if errors.Is(err, database.ErrNotFound) {
+			return serviceerrors.NewNotFound("Memory entry not found", nil)
+		}
+		return serviceerrors.NewInternal("failed to delete memory entry", err)
+	}
+	return nil
+}
