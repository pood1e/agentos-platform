+)
+
+type memoryEntryStore struct {
+	memoryservice.Store
+	deleted []string
+}
+
+func (store *memoryEntryStore) DeleteMemoryEntry(_ context.Context, agent, user, id string) error {
+	store.deleted = []string{agent, user, id}
+	return nil
+}
+
+func TestMemoryDeleteEntryValidatesAndRequiresWriteAccess(t *testing.T) {
+	const id = "314c85fc-41b8-49ae-a3d9-73b86d8f54b8"
+	request := &apiv1alpha1.MemoryServiceDeleteEntryRequest{AgentName: "agent", UserId: "owner", Id: id}
+	validator, err := protovalidate.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := validator.Validate(request); err != nil {
+		t.Fatal(err)
+	}
+	if err := validator.Validate(&apiv1alpha1.MemoryServiceDeleteEntryRequest{AgentName: "agent", UserId: "owner"}); err == nil {
+		t.Fatal("deletion accepted a missing memory ID")
+	}
+	session := &testSession{principal: auth.Principal{User: auth.User{ID: "owner"}}}
+	shareStore := &testShareStore{
+		sessionShare: &apiv1alpha1.SessionShare{SessionId: testSessionID.String(), Permission: apiv1alpha1.SessionSharePermission_SESSION_SHARE_PERMISSION_READ_ONLY}, ownerUserID: "owner",
+	}
+	ctx := metadata.NewIncomingContext(t.Context(), metadata.Pairs("x-share-token", "token"))
+	if _, err := authenticate(ctx, apiv1alpha1.MemoryService_DeleteEntry_FullMethodName, &testAuthenticator{session: session}, nil, shareStore, DefaultMethodPolicies()); status.Code(err) != codes.PermissionDenied {
+		t.Fatalf("read-only share deletion error = %v", err)
+	}
+	store := &memoryEntryStore{}
+	server := newMemoryServer(memoryservice.NewService(store))
+	if _, err := server.DeleteEntry(auth.AuthSessionTo(t.Context(), session), request); err != nil {
+		t.Fatal(err)
+	}
+	if len(store.deleted) != 3 || store.deleted[0] != "agent" || store.deleted[1] != "owner" || store.deleted[2] != id {
+		t.Fatalf("handler changed deletion scope: %v", store.deleted)
+	}
+}
