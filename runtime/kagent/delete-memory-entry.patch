diff --git a/go/core/internal/database/memory_entry_test.go b/go/core/internal/database/memory_entry_test.go
new file mode 100644
index 00000000..6e57503d
--- /dev/null
+++ b/go/core/internal/database/memory_entry_test.go
@@ -0,0 +1,27 @@
+package database
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestDeleteMemoryEntryPreservesOtherRecordsAndScopes(t *testing.T) {
+	client := NewClient(setupTestDB(t), "public")
+	ctx := t.Context()
+	first := &Memory{AgentName: "my_agent", UserID: "owner", Content: "delete", Embedding: makeEmbedding(0.5)}
+	second := &Memory{AgentName: "my_agent", UserID: "owner", Content: "keep", Embedding: makeEmbedding(0.5)}
+	require.NoError(t, client.StoreAgentMemories(ctx, first, second))
+	require.ErrorIs(t, client.DeleteMemoryEntry(ctx, "my-agent", "other", first.ID), ErrNotFound)
+	require.ErrorIs(t, client.DeleteMemoryEntry(ctx, "other-agent", "owner", first.ID), ErrNotFound)
+	require.NoError(t, client.DeleteMemoryEntry(ctx, "my-agent", "owner", first.ID))
+	require.ErrorIs(t, client.DeleteMemoryEntry(ctx, "my-agent", "owner", first.ID), ErrNotFound)
+	memories, err := client.ListAgentMemories(ctx, "my-agent", "owner")
+	require.NoError(t, err)
+	require.Len(t, memories, 1)
+	require.Equal(t, second.ID, memories[0].ID)
+	results, err := client.SearchAgentMemory(ctx, "my-agent", "owner", makeEmbedding(0.5), 5)
+	require.NoError(t, err)
+	require.Len(t, results, 1)
+	require.Equal(t, second.ID, results[0].ID)
+}
