+package memory
+
+import (
+	"testing"
+
+	"github.com/kagent-dev/kagent/go/core/internal/database"
+	"github.com/kagent-dev/kagent/go/core/internal/service/serviceerrors"
+	"github.com/kagent-dev/kagent/go/core/pkg/auth"
+)
+
+type memoryCaller struct{ userID string }
+
+func (caller memoryCaller) Principal() auth.Principal {
+	return auth.Principal{User: auth.User{ID: caller.userID}}
+}
+
+func TestDeleteEntryEnforcesIdentityAndScope(t *testing.T) {
+	const id = "314c85fc-41b8-49ae-a3d9-73b86d8f54b8"
+	store := &memoryStore{}
+	service := NewService(store)
+	ctx := auth.AuthSessionTo(t.Context(), memoryCaller{userID: "owner"})
+	for _, test := range []struct {
+		user string
+		id   string
+		code serviceerrors.Code
+	}{
+		{user: "owner", id: "", code: serviceerrors.CodeInvalidArgument},
+		{user: "other", id: id, code: serviceerrors.CodePermissionDenied},
+	} {
+		if err := service.DeleteEntry(ctx, "agent", test.user, test.id); !serviceerrors.IsCode(err, test.code) {
+			t.Fatalf("DeleteEntry() error = %v, want %s", err, test.code)
+		}
+	}
+	if store.deletedID != "" {
+		t.Fatal("invalid requests reached storage")
+	}
+	if err := service.DeleteEntry(t.Context(), "agent", "owner", id); !serviceerrors.IsCode(err, serviceerrors.CodeUnauthenticated) {
+		t.Fatalf("missing identity error = %v", err)
+	}
+	if err := service.DeleteEntry(ctx, "agent", "owner", id); err != nil {
+		t.Fatal(err)
+	}
+	if store.deletedID != id || store.deletedAgent != "agent" || store.deletedUser != "owner" {
+		t.Fatal("deletion lost the memory ID or ownership scope")
+	}
+	store.err = database.ErrNotFound
+	if err := service.DeleteEntry(ctx, "agent", "owner", id); !serviceerrors.IsCode(err, serviceerrors.CodeNotFound) {
+		t.Fatalf("missing memory error = %v", err)
+	}
+}
