+// DeleteMemoryEntry atomically deletes one memory owned by the supplied agent and
+// user. The agent's underscore spelling is accepted; missing or foreign rows return ErrNotFound.
+func (c *Client) DeleteMemoryEntry(ctx context.Context, agentName, userID, id string) error {
+	normalized := strings.ReplaceAll(agentName, "-", "_")
+	tag, err := c.db.Exec(ctx, `
+		DELETE FROM memory
+		WHERE id = $1 AND (agent_name = $2 OR agent_name = $4) AND user_id = $3
+	`, id, agentName, userID, normalized)
+	if err != nil {
+		return fmt.Errorf("failed to delete memory entry: %w", err)
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrNotFound
+	}
+	return nil
+}
