@@ -0,0 +1,72 @@
+package substrate
+
+import (
+	"fmt"
+	"testing"
+
+	apia2a "github.com/kagent-dev/kagent/go/api/a2a"
+	"github.com/kagent-dev/kagent/go/core/internal/egress"
+)
+
+func TestActorIdentityIsBoundToEachEgressOrigin(t *testing.T) {
+	policy, err := ActorEgressPolicy("workspace", []string{
+		"http://gateway.example:8080", "https://gateway.example:8443",
+	}, []egress.Credential{{Hostname: "gateway.example", Header: "authorization", Prefix: "Bearer ", URI: "ate-secret://k8s.io/default/workspace/credential/token"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(policy.GetRules()) != 2 {
+		t.Fatalf("rule count = %d, want 2", len(policy.GetRules()))
+	}
+	first := policy.GetRules()[0].GetHttp().GetEffects().GetReplaceHeaders()
+	second := policy.GetRules()[1].GetHttps().GetEffects().GetReplaceHeaders()
+	if len(first) != 2 || len(second) != 2 {
+		t.Fatal("each origin must carry its Secret credential and Actor identity")
+	}
+	for _, test := range []struct {
+		origin  string
+		headers []string
+	}{
+		{origin: "http://gateway.example:8080", headers: []string{first[1].GetActorJwt().GetAudiences()[0]}},
+		{origin: "https://gateway.example:8443", headers: []string{second[1].GetActorJwt().GetAudiences()[0]}},
+	} {
+		for _, audience := range test.headers {
+			if audience != test.origin {
+				t.Errorf("audience = %q, want %q", audience, test.origin)
+			}
+		}
+	}
+	if first[1].GetHeader() != actorTokenHeader {
+		t.Fatalf("identity header name = %q", first[1].GetHeader())
+	}
+	if first[1].GetActorJwt().GetExpirationSeconds() != 300 || first[1].GetPrefix() != "Bearer " {
+		t.Fatal("identity token is not short-lived bearer authentication")
+	}
+	first[0].Prefix = "changed"
+	if second[0].GetPrefix() != "Bearer " {
+		t.Fatal("origin-specific effects share mutable credential state")
+	}
+}
+
+func TestActorIdentityHeadersRejectSecretOverrides(t *testing.T) {
+	for _, header := range []string{actorTokenHeader, apia2a.InsecureRuntimeIdentityHeader, "X-Substrate-Actor-Token"} {
+		t.Run(header, func(t *testing.T) {
+			_, err := ActorEgressPolicy("workspace", []string{"https://gateway.example"}, []egress.Credential{{
+				Hostname: "gateway.example", Header: header, URI: "ate-secret://k8s.io/default/workspace/credential/token",
+			}})
+			if err == nil {
+				t.Fatal("Secret credential replaced the reserved actor identity")
+			}
+		})
+	}
+}
+
+func TestActorIdentityHeadersRespectNativePolicyLimits(t *testing.T) {
+	var credentials []egress.Credential
+	for i := range 16 {
+		credentials = append(credentials, egress.Credential{Hostname: "gateway.example", Header: fmt.Sprintf("x-credential-%d", i), URI: "ate-secret://k8s.io/default/workspace/credential/token"})
+	}
+	if _, err := ActorEgressPolicy("workspace", []string{"https://gateway.example"}, credentials); err == nil {
+		t.Fatal("policy exceeded the native credential header limit")
+	}
+}
