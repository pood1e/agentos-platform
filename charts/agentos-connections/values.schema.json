{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "jwtProvider": {
      "properties": {
        "audiences": {
          "description": "Allowed audiences that are allowed\naccess. This corresponds to the `aud` claim\n([RFC 7519 §4.1.3](https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.3)).\nIf unset, any audience is allowed.",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "issuer": {
          "description": "IdP that issued the JWT. This corresponds to the\n`iss` claim ([RFC 7519 §4.1.1](https://tools.ietf.org/html/rfc7519#section-4.1.1)).",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "jwks": {
          "description": "JSON Web Key Set used to validate the signature of the\nJWT.",
          "properties": {
            "inline": {
              "description": "Inline JSON Web Key Set used to validate the\nsignature of the JWT.",
              "maxLength": 65536,
              "minLength": 2,
              "type": "string"
            },
            "remote": {
              "description": "How to reach the JSON Web Key Set from a remote\naddress.",
              "properties": {
                "backendRef": {
                  "description": "`backendRef` selects a backend for this policy.\nMutually exclusive with `url`.",
                  "properties": {
                    "group": {
                      "default": "",
                      "description": "Group of the referent, for example `gateway.networking.k8s.io`. Empty selects the core API group",
                      "maxLength": 253,
                      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                      "type": "string"
                    },
                    "kind": {
                      "default": "Service",
                      "description": "Kubernetes resource kind of the referent, for example `Service`. Defaults to `Service`",
                      "maxLength": 63,
                      "minLength": 1,
                      "pattern": "^[a-zA-Z]([-a-zA-Z0-9]*[a-zA-Z0-9])?$",
                      "type": "string"
                    },
                    "name": {
                      "description": "Name is the name of the referent.",
                      "maxLength": 253,
                      "minLength": 1,
                      "type": "string"
                    },
                    "namespace": {
                      "description": "Namespace of the referent. Defaults to the local namespace. A cross-namespace reference requires a ReferenceGrant in the referent namespace",
                      "maxLength": 63,
                      "minLength": 1,
                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                      "type": "string"
                    },
                    "port": {
                      "description": "Destination port number. Required when the referent is a Kubernetes `Service`",
                      "format": "int32",
                      "maximum": 65535,
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": ["name"],
                  "type": "object",
                  "x-kubernetes-validations": [
                    {
                      "message": "Must have port for Service reference",
                      "rule": "(size(self.group) == 0 && self.kind == 'Service') ? has(self.port) : true"
                    }
                  ]
                },
                "cacheDuration": {
                  "description": "How long a fetched `jwks` document is used before it is re-fetched from the IdP.\nDefaults to `5m`.",
                  "maxLength": 32,
                  "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$",
                  "type": "string",
                  "x-kubernetes-validations": [
                    {
                      "message": "cacheDuration must be at least 5m.",
                      "rule": "duration(self) >= duration('5m')"
                    }
                  ]
                },
                "jwksPath": {
                  "description": "Path to the IdP `jwks` endpoint, relative to the root, commonly\n`\".well-known/jwks.json\"`.",
                  "maxLength": 1024,
                  "minLength": 1,
                  "type": "string"
                },
                "url": {
                  "description": "`url` directly specifies the HTTP(S) endpoint for this policy.\nWhen the scheme is `https`, backend TLS is enabled automatically.\nMutually exclusive with `backendRef`.\nURLs are opaque; referencing a Kubernetes service hostname like `hello.ns.svc.cluster.local`\nwill not apply Service policies or load balancing.",
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^https?://[^/?#@]+(/[^?#]*)?$",
                  "type": "string"
                }
              },
              "type": "object",
              "x-kubernetes-validations": [
                {
                  "message": "jwksPath is required when backendRef is set",
                  "rule": "has(self.backendRef) ? has(self.jwksPath) : true"
                },
                {
                  "message": "jwksPath may not be set when url is set",
                  "rule": "has(self.url) ? !has(self.jwksPath) : true"
                },
                {
                  "message": "exactly one of the fields in [backendRef url] must be set",
                  "rule": "(has(self.backendRef)?1:0)+(has(self.url)?1:0) == 1"
                }
              ]
            }
          },
          "type": "object",
          "x-kubernetes-validations": [
            {
              "message": "exactly one of the fields in [remote inline] must be set",
              "rule": "(has(self.remote)?1:0)+(has(self.inline)?1:0) == 1"
            }
          ]
        },
        "validation": {
          "description": "Additional JWT claim presence requirements. Defaults to requiring `exp`.\nIssuer validation always requires `iss`; a non-empty audiences list also\nrequires `aud`, regardless of these options. An empty `requiredClaims`\nlist removes only the additional presence requirements. Expiration is\nstill checked whenever `exp` is present.",
          "properties": {
            "requiredClaims": {
              "description": "Additional claims that must be present in the token payload.\nRecognized values: `exp`, `nbf`, `aud`, `sub`.\nDefaults to `[\"exp\"]` when omitted. An empty list adds no requirements\nbeyond `iss`, which is always required, and `aud`, which is required\nwhen a non-empty audiences list is configured. Expiration is still\nchecked whenever `exp` is present.",
              "items": {
                "description": "JWTClaim is a JWT claim whose presence can be required during validation.",
                "enum": ["aud", "exp", "nbf", "sub"],
                "type": "string"
              },
              "maxItems": 4,
              "type": "array",
              "x-kubernetes-list-type": "atomic"
            }
          },
          "type": "object"
        }
      },
      "required": ["issuer", "jwks", "audiences"],
      "type": "object",
      "additionalProperties": false
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1
        },
        "controllerServiceAccount": {
          "type": "string",
          "minLength": 1
        },
        "actorIssuer": {
          "type": "string",
          "pattern": "^https://[^/]+"
        },
        "authentication": {
          "oneOf": [
            {
              "$ref": "#/definitions/jwtProvider"
            },
            {
              "type": "object",
              "maxProperties": 0
            }
          ]
        },
        "writerRole": {
          "type": "string"
        }
      },
      "required": ["release", "controllerServiceAccount", "actorIssuer"]
    },
    "environments": {
      "type": "array",
      "items": {
        "description": "Environment declares one external environment's authorization boundary.",
        "properties": {
          "discoveryAuth": {
            "description": "DiscoveryAuth authenticates the native controller catalog refresh.",
            "properties": {
              "oauth2": {
                "description": "MCPDiscoveryOAuth2 uses the OAuth 2.0 client credentials grant.",
                "properties": {
                  "caCertificateRef": {
                    "description": "CACertificateRef adds a PEM certificate bundle to system trust for the token endpoint.",
                    "properties": {
                      "key": {
                        "description": "The key to select from the ConfigMap's Data field.\nKeys in the BinaryData field are not currently propagated to container env vars.",
                        "type": "string"
                      },
                      "name": {
                        "default": "",
                        "description": "Name of the referent.\nThis field is effectively required, but due to backwards compatibility is\nallowed to be empty. Instances of this type with an empty value here are\nalmost certainly wrong.\nMore info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names",
                        "type": "string"
                      },
                      "optional": {
                        "description": "Specify whether the ConfigMap or its key must be defined",
                        "type": "boolean"
                      }
                    },
                    "required": ["key"],
                    "type": "object",
                    "x-kubernetes-map-type": "atomic"
                  },
                  "clientId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "clientSecretRef": {
                    "description": "ClientSecretRef selects a same-namespace Secret.",
                    "properties": {
                      "key": {
                        "description": "The key of the secret to select from.  Must be a valid secret key.",
                        "type": "string"
                      },
                      "name": {
                        "default": "",
                        "description": "Name of the referent.\nThis field is effectively required, but due to backwards compatibility is\nallowed to be empty. Instances of this type with an empty value here are\nalmost certainly wrong.\nMore info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names",
                        "type": "string"
                      },
                      "optional": {
                        "description": "Specify whether the Secret or its key must be defined",
                        "type": "boolean"
                      }
                    },
                    "required": ["key"],
                    "type": "object",
                    "x-kubernetes-map-type": "atomic"
                  },
                  "scopes": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 32,
                    "type": "array"
                  },
                  "tokenEndpoint": {
                    "pattern": "^https://[^/?#@]+[^#]*$",
                    "type": "string"
                  }
                },
                "required": ["clientId", "clientSecretRef", "tokenEndpoint"],
                "type": "object"
              },
              "serviceAccount": {
                "description": "MCPDiscoveryServiceAccount requests a short-lived Kubernetes token.",
                "properties": {
                  "audience": {
                    "maxLength": 512,
                    "minLength": 1,
                    "type": "string"
                  },
                  "serviceAccountRef": {
                    "description": "ServiceAccountRef selects a same-namespace ServiceAccount.",
                    "properties": {
                      "name": {
                        "default": "",
                        "description": "Name of the referent.\nThis field is effectively required, but due to backwards compatibility is\nallowed to be empty. Instances of this type with an empty value here are\nalmost certainly wrong.\nMore info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names",
                        "type": "string"
                      }
                    },
                    "type": "object",
                    "x-kubernetes-map-type": "atomic"
                  }
                },
                "required": ["audience", "serviceAccountRef"],
                "type": "object"
              }
            },
            "type": "object",
            "x-kubernetes-validations": [
              {
                "message": "exactly one of the fields in [oauth2 serviceAccount] must be set",
                "rule": "(has(self.oauth2)?1:0)+(has(self.serviceAccount)?1:0) == 1"
              }
            ]
          },
          "gateway": {
            "description": "EnvironmentGateway is the TLS gateway exposed by a connected environment.",
            "properties": {
              "address": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "nodePort": {
                "format": "int32",
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "ca": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["address", "host", "nodePort"],
            "type": "object"
          },
          "governance": {
            "enum": ["approval", "direct"],
            "type": "string"
          },
          "identities": {
            "items": {
              "description": "Identity selects services and optionally restricts the environments in which it exists.",
              "properties": {
                "environments": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 32,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "name": {
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "type": "string"
                },
                "services": {
                  "additionalProperties": {
                    "description": "Access identifies an identity's capability boundary.",
                    "enum": ["read", "operate", "manage"],
                    "type": "string"
                  },
                  "maxProperties": 32,
                  "type": "object"
                }
              },
              "required": ["name", "services"],
              "type": "object"
            },
            "maxItems": 64,
            "type": "array",
            "x-kubernetes-list-map-keys": ["name"],
            "x-kubernetes-list-type": "map"
          },
          "issuer": {
            "pattern": "^https://[^/]+",
            "type": "string"
          },
          "jwksURL": {
            "pattern": "^https://[^/]+",
            "type": "string"
          },
          "name": {
            "maxLength": 32,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "resource": {
            "pattern": "^https://[^/]+",
            "type": "string"
          },
          "titles": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "toolsets": {
            "additionalProperties": {
              "description": "Toolset declares disjoint capability tiers for one service.",
              "properties": {
                "approval": {
                  "description": "Omitted approvals default to every write capability; an empty list requires none.",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 200,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "management": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "managementReadOnly": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "readOnly": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "write": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                }
              },
              "type": "object"
            },
            "maxProperties": 32,
            "type": "object"
          },
          "apis": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "description": "Unary Connect JSON APIs served by the environment's OAuth resource.",
              "properties": {
                "readMethods": {
                  "items": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "service": {
                  "default": "",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
                  "type": "string"
                },
                "writeMethods": {
                  "items": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "title": "Environment Api",
              "type": "object"
            }
          },
          "tokenEndpointURL": {
            "type": "string",
            "pattern": "^https://[^/]+"
          }
        },
        "required": [
          "governance",
          "name",
          "issuer",
          "resource",
          "gateway",
          "tokenEndpointURL",
          "jwksURL",
          "discoveryAuth"
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  },
  "required": ["platform", "environments"],
  "anyOf": [
    {
      "properties": {
        "environments": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "platform": {
          "required": ["authentication", "writerRole"],
          "properties": {
            "authentication": {
              "$ref": "#/definitions/jwtProvider"
            },
            "writerRole": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
