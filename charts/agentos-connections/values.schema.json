{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "controllerServiceAccount": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "actorIssuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+"
        }
      },
      "required": ["release", "controllerServiceAccount", "actorIssuer"]
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 45,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "governance": {
            "enum": ["approval", "direct"]
          },
          "issuer": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/]+"
          },
          "resource": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/]+"
          },
          "gateway": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": "string",
                "minLength": 1
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "nodePort": {
                "type": "integer",
                "minimum": 30000,
                "maximum": 32767
              },
              "ca": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["address", "host", "nodePort", "ca"]
          },
          "toolsets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "readOnly": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "write": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "managementReadOnly": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "management": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "approval": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            },
            "minProperties": 1
          },
          "identities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "services"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "environments": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 45,
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                  }
                },
                "services": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": ["read", "operate", "manage"]
                  }
                }
              }
            },
            "minItems": 1,
            "contains": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": {
                  "const": "catalog"
                }
              },
              "required": ["name"]
            }
          },
          "titles": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "approvalUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/]+"
          },
          "authorization": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "governance",
          "issuer",
          "resource",
          "gateway",
          "toolsets",
          "identities",
          "titles"
        ]
      }
    }
  },
  "required": ["platform", "environments"]
}
