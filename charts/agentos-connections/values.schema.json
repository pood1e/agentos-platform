{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1
        },
        "controllerServiceAccount": {
          "type": "string",
          "minLength": 1
        },
        "actorIssuer": {
          "type": "string",
          "pattern": "^https://[^/]+"
        }
      },
      "required": ["release", "controllerServiceAccount", "actorIssuer"]
    },
    "environments": {
      "type": "array",
      "items": {
        "description": "Environment declares one external environment's authorization boundary.",
        "properties": {
          "gateway": {
            "description": "EnvironmentGateway is the TLS gateway exposed by a connected environment.",
            "properties": {
              "address": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "nodePort": {
                "format": "int32",
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "ca": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["address", "host", "nodePort"],
            "type": "object"
          },
          "governance": {
            "enum": ["approval", "direct"],
            "type": "string"
          },
          "identities": {
            "items": {
              "description": "Identity selects services and optionally restricts the environments in which it exists.",
              "properties": {
                "environments": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 32,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "name": {
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "type": "string"
                },
                "services": {
                  "additionalProperties": {
                    "description": "Access identifies an identity's capability boundary.",
                    "enum": ["read", "operate", "manage"],
                    "type": "string"
                  },
                  "maxProperties": 32,
                  "type": "object"
                }
              },
              "required": ["name", "services"],
              "type": "object"
            },
            "maxItems": 64,
            "type": "array",
            "x-kubernetes-list-map-keys": ["name"],
            "x-kubernetes-list-type": "map"
          },
          "issuer": {
            "pattern": "^https://[^/]+",
            "type": "string"
          },
          "jwksURL": {
            "pattern": "^https://[^/]+",
            "type": "string"
          },
          "name": {
            "maxLength": 32,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "resource": {
            "pattern": "^https://[^/]+",
            "type": "string"
          },
          "titles": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "toolsets": {
            "additionalProperties": {
              "description": "Toolset declares disjoint capability tiers for one service.",
              "properties": {
                "approval": {
                  "description": "Omitted approvals default to every write capability; an empty list requires none.",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 200,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "management": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "managementReadOnly": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "readOnly": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                },
                "write": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array",
                  "x-kubernetes-list-type": "set"
                }
              },
              "type": "object"
            },
            "maxProperties": 32,
            "type": "object"
          },
          "apis": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "description": "Unary Connect JSON APIs served by the environment's OAuth resource.",
              "patternProperties": {
                "^(read_methods)$": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "^(write_methods)$": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "properties": {
                "readMethods": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "service": {
                  "default": "",
                  "minLength": 1,
                  "type": "string"
                },
                "writeMethods": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "title": "Environment Api",
              "type": "object"
            }
          },
          "approvalUrl": {
            "type": "string",
            "pattern": "^https://[^/]+"
          },
          "authorization": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["governance", "name"],
        "type": "object"
      }
    }
  },
  "required": ["platform", "environments"]
}
