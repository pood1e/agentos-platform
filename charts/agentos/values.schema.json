{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "required": ["agentos"],
      "properties": {
        "agentos": {
          "type": "object",
          "additionalProperties": false,
          "required": ["environments", "toolsets", "identities", "skills", "skillRepository"],
          "properties": {
            "environments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "governance"],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 45,
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                  },
                  "governance": {
                    "enum": ["approval", "direct"]
                  }
                }
              }
            },
            "toolsets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "readOnly": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "write": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "managementReadOnly": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "management": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "approval": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              }
            },
            "identities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "services"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "environments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 45,
                      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                    }
                  },
                  "services": {
                    "type": "object",
                    "additionalProperties": {
                      "enum": ["read", "operate", "manage"]
                    }
                  }
                }
              }
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["skill"]
              }
            },
            "skillRepository": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host", "path", "secretRef"],
              "properties": {
                "host": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^(/([a-zA-Z0-9_-]+/)+[a-zA-Z0-9_-]+\\.git)?$"
                },
                "secretRef": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": ["repository", "digest"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name"]
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^(.+@sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "kagent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "userId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["endpoint", "userId"]
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number"]
            }
          }
        }
      },
      "required": ["resources"]
    },
    "access": false,
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "tlsSecret": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["host", "tlsSecret"]
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec": {
          "type": "object"
        }
      },
      "required": ["spec"]
    },
    "knowledgeMemory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlDays": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["ttlDays"]
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "@sha256:[a-f0-9]{64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number"]
            }
          }
        }
      },
      "required": ["image", "model", "digest", "storage", "resources"]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "models", "mcps"],
      "properties": {
        "parameters": {
          "type": "object"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "spec"],
            "properties": {
              "name": {
                "type": "string"
              },
              "spec": {
                "type": "object"
              }
            }
          }
        },
        "mcps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "spec"],
            "properties": {
              "name": {
                "type": "string"
              },
              "spec": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "harnesses": {
      "type": "object",
      "required": ["standard", "memory"],
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/harnessSpec"
      }
    },
    "systemAgents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistant": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "systemPrompt": {
              "type": "string"
            }
          }
        },
        "roleBuilder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "systemPrompt": {
              "type": "string"
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "kagentURL": {
          "type": "string",
          "pattern": "^$|^https?://[^ ]+$"
        },
        "langfuseURL": {
          "type": "string",
          "pattern": "^$|^https?://[^ ]+$"
        },
        "langfuseNamespace": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "langfuseSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "feedbackURL": {
          "type": "string",
          "pattern": "^$|^https?://[^ ]+$"
        },
        "feedbackSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spec": {
              "type": "object"
            }
          },
          "required": ["spec"]
        },
        "baseline": {
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "namespace",
        "kagentURL",
        "langfuseURL",
        "langfuseNamespace",
        "langfuseSecret",
        "feedbackURL",
        "feedbackSecret",
        "judge",
        "baseline"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "namespace": {
                "minLength": 1
              },
              "kagentURL": {
                "minLength": 1
              },
              "langfuseURL": {
                "minLength": 1
              },
              "langfuseNamespace": {
                "minLength": 1
              },
              "langfuseSecret": {
                "minLength": 1
              },
              "feedbackURL": {
                "minLength": 1
              },
              "feedbackSecret": {
                "minLength": 1
              },
              "judge": {
                "properties": {
                  "spec": {
                    "required": ["provider", "match", "baseURL"],
                    "properties": {
                      "match": {
                        "type": "object",
                        "required": ["model"],
                        "properties": {
                          "model": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              },
              "baseline": {
                "minProperties": 1
              }
            }
          }
        }
      ]
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": ["enabled"]
    },
    "entryAgent": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "clientId", "writerRole", "secretRef", "proxy", "mode", "audience"],
      "properties": {
        "issuer": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "writerRole": {
          "type": "string"
        },
        "secretRef": {
          "type": "string",
          "minLength": 1
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "resources"],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "@sha256:[0-9a-f]{64}$"
            },
            "resources": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "number"]
                }
              }
            }
          }
        },
        "mode": {
          "enum": ["none", "oidc"]
        },
        "audience": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "oidc"
              }
            }
          },
          "then": {
            "properties": {
              "issuer": {
                "pattern": "^https://[^\\s]+$"
              },
              "clientId": {
                "minLength": 1
              },
              "writerRole": {
                "minLength": 1
              },
              "audience": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "global",
    "image",
    "imagePullSecrets",
    "kagent",
    "console",
    "ingress",
    "modelConfig",
    "harnesses",
    "knowledgeMemory",
    "embedding",
    "gateway",
    "systemAgents",
    "pack"
  ],
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$defs": {
    "harnessSpec": {
      "description": "HarnessSpec defines a reusable runtime and its infrastructure policy.",
      "properties": {
        "byo": {
          "description": "BYOHarness selects an image that implements kagent's private A2A contract.",
          "type": "object"
        },
        "claude": {
          "description": "ClaudeHarness selects the Claude runtime adapter.",
          "type": "object"
        },
        "codex": {
          "description": "CodexHarness selects the Codex runtime adapter.",
          "type": "object"
        },
        "env": {
          "items": {
            "description": "RuntimeEnvVar configures one literal runtime environment variable.",
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "value": {
                "description": "Value is a literal value, including an empty string.",
                "type": "string"
              }
            },
            "required": ["name", "value"],
            "type": "object"
          },
          "maxItems": 100,
          "type": "array",
          "x-kubernetes-list-map-keys": ["name"],
          "x-kubernetes-list-type": "map"
        },
        "kagent": {
          "description": "KagentHarness configures the kagent runtime adapter.",
          "properties": {
            "compaction": {
              "description": "Compaction summarizes older session events so the prompt stays small as\na conversation grows. Omitted leaves the history uncompacted.",
              "properties": {
                "compactionInterval": {
                  "description": "CompactionInterval is the number of new user-initiated invocations that,\nonce fully represented in the session, triggers a sliding-window\ncompaction of those invocations.",
                  "minimum": 1,
                  "type": "integer"
                },
                "eventRetentionSize": {
                  "description": "EventRetentionSize is the number of most recent events that tail\nretention keeps uncompacted.",
                  "minimum": 1,
                  "type": "integer"
                },
                "overlapSize": {
                  "description": "OverlapSize is the number of already-compacted invocations pulled back\ninto the next sliding window so consecutive summaries overlap.",
                  "minimum": 0,
                  "type": "integer"
                },
                "summarizer": {
                  "description": "Summarizer selects the model and prompt that write the summaries.\nOmitted summarizes with the agent's own model and the runtime's default\nprompt.",
                  "properties": {
                    "modelConfigRef": {
                      "description": "ModelConfigRef references the ModelConfig in the Harness namespace that\nwrites the summaries. Omitted uses the agent's own model.",
                      "properties": {
                        "name": {
                          "default": "",
                          "description": "Name of the referent.\nThis field is effectively required, but due to backwards compatibility is\nallowed to be empty. Instances of this type with an empty value here are\nalmost certainly wrong.\nMore info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names",
                          "type": "string"
                        }
                      },
                      "type": "object",
                      "x-kubernetes-map-type": "atomic",
                      "x-kubernetes-validations": [
                        {
                          "message": "name must not be empty",
                          "rule": "has(self.name) && self.name != ''"
                        }
                      ]
                    },
                    "promptTemplate": {
                      "description": "PromptTemplate replaces the runtime's default summarization prompt. It\nmust contain {conversation_history}, which the runtime replaces with the\nrendered events.",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "x-kubernetes-validations": [
                    {
                      "message": "promptTemplate must contain {conversation_history}",
                      "rule": "!has(self.promptTemplate) || self.promptTemplate.contains('{conversation_history}')"
                    }
                  ]
                },
                "tokenThreshold": {
                  "description": "TokenThreshold is the prompt token count at which tail-retention\ncompaction summarizes the history before the next model call.",
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "type": "object",
              "x-kubernetes-validations": [
                {
                  "message": "compactionInterval or tokenThreshold must be specified",
                  "rule": "has(self.compactionInterval) || has(self.tokenThreshold)"
                },
                {
                  "message": "tokenThreshold and eventRetentionSize must be specified together",
                  "rule": "has(self.tokenThreshold) == has(self.eventRetentionSize)"
                },
                {
                  "message": "overlapSize requires compactionInterval",
                  "rule": "!has(self.overlapSize) || has(self.compactionInterval)"
                }
              ]
            },
            "memory": {
              "description": "Memory enables long-term memory for agents using this Harness.",
              "properties": {
                "modelConfigRef": {
                  "description": "ModelConfigRef references the embedding ModelConfig in the Harness namespace.",
                  "properties": {
                    "name": {
                      "default": "",
                      "description": "Name of the referent.\nThis field is effectively required, but due to backwards compatibility is\nallowed to be empty. Instances of this type with an empty value here are\nalmost certainly wrong.\nMore info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "x-kubernetes-map-type": "atomic"
                },
                "ttlDays": {
                  "description": "TTLDays controls how many days a stored memory entry remains valid.",
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": ["modelConfigRef"],
              "type": "object",
              "x-kubernetes-validations": [
                {
                  "message": "modelConfigRef name must not be empty",
                  "rule": "self.modelConfigRef.name.size() > 0"
                }
              ]
            }
          },
          "type": "object"
        },
        "substrate": {
          "description": "RuntimeSubstratePolicy contains the Substrate policy shared by all runtime variants.",
          "properties": {
            "snapshotPolicy": {
              "description": "SnapshotPolicy configures runtime snapshot storage.",
              "properties": {
                "location": {
                  "description": "Location is the snapshot storage location used by Substrate.",
                  "pattern": "^[^[:space:]]+$",
                  "type": "string"
                }
              },
              "required": ["location"],
              "type": "object"
            },
            "workerPoolRef": {
              "description": "WorkerPoolRef references a WorkerPool in the resource's namespace.",
              "properties": {
                "name": {
                  "default": "",
                  "description": "Name of the referent.\nThis field is effectively required, but due to backwards compatibility is\nallowed to be empty. Instances of this type with an empty value here are\nalmost certainly wrong.\nMore info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names",
                  "type": "string"
                }
              },
              "type": "object",
              "x-kubernetes-map-type": "atomic"
            }
          },
          "required": ["snapshotPolicy", "workerPoolRef"],
          "type": "object",
          "x-kubernetes-validations": [
            {
              "message": "workerPoolRef name must not be empty",
              "rule": "self.workerPoolRef.name.size() > 0"
            }
          ]
        },
        "workload": {
          "description": "HarnessWorkload identifies the immutable runtime image used by a Harness.",
          "properties": {
            "args": {
              "description": "Args overrides the image command arguments when set.",
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            "command": {
              "description": "Command overrides the image entrypoint when set.",
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            "image": {
              "description": "Image is an OCI image reference pinned by sha256 digest.",
              "pattern": "^[^[:space:]@]+@sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": ["image"],
          "type": "object"
        }
      },
      "required": ["substrate", "workload"],
      "type": "object",
      "x-kubernetes-validations": [
        {
          "message": "exactly one of kagent, codex, claude, or byo must be specified",
          "rule": "(has(self.kagent) ? 1 : 0) + (has(self.codex) ? 1 : 0) + (has(self.claude) ? 1 : 0) + (has(self.byo) ? 1 : 0) == 1"
        },
        {
          "message": "BYO harnesses must specify workload.command",
          "rule": "!has(self.byo) || size(self.workload.command) > 0"
        }
      ]
    }
  }
}
