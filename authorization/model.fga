model
  schema 1.1

type principal

type workspace
  relations
    define administrator: [principal]
    define member: [principal]
    define can_read: member or administrator
    define can_manage: administrator

type agent
  relations
    define workspace: [workspace]
    define caller: [principal]
    define editor: [principal]
    define can_invoke: caller or administrator from workspace
    define can_manage: editor or administrator from workspace

type session
  relations
    define workspace: [workspace]
    define owner: [principal]
    define reader: [principal]
    define operator: [principal]
    define can_read: owner or reader or operator or administrator from workspace
    define can_operate: owner or operator or administrator from workspace

type grant
  relations
    define initiator: [principal]
    define assignee: [agent]
    define session: [session]
    define live: [principal with unexpired]
    define root: [principal]
    define parent: [grant]
    define can_execute: initiator and live and (root or can_execute from parent)

type resource
  relations
    define reader: [principal]
    define operator: [principal]
    define readable_by: [agent]
    define operable_by: [agent]
    define read_grant: [grant]
    define operate_grant: [grant]
    define can_read: reader or operator
    define can_operate: operator
    define agent_can_read: readable_by or operable_by
    define agent_can_operate: operable_by
    define grant_can_read: read_grant or operate_grant
    define grant_can_operate: operate_grant

condition unexpired(current_time: timestamp, expires_at: timestamp) {
  current_time < expires_at
}
