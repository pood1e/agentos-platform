global:
  watchNamespaces: ["{{ agentos_namespace }}"{% if agentos_evaluation_enabled %}, "{{ agentos_evaluation_namespace }}"{% endif %}]
providers: null
database:
  postgres:
    readWriteConnectionStringSecretRef: {name: kagent-postgres, key: connectionString}
    ownerConnectionStringSecretRef: {name: kagent-postgres, key: connectionString}
config:
  harnessImages:
    release: "{{ kagent_version }}-agentos.1"
    kagent: "{{ harness_defaults.standard.workload.image | replace('registry.example.com/agentos', agentos_image_registry) }}"
    claude: "{{ harness_defaults.claude.workload.image | replace('registry.example.com/agentos', agentos_image_registry) }}"
    codex: "{{ harness_defaults.codex.workload.image | replace('registry.example.com/agentos', agentos_image_registry) }}"
  database:
    owner: {role: kagent_owner}
    readWrite: {role: kagent_owner}
    vectorEnabled: true
  sandboxes:
    guestImage: ghcr.io/kagent-dev/kagent/sandbox-guest@sha256:5355072effb219e157c3e0471637ca64d1f84ab7513dde23968c20cd65d18c9b
    cpu: "1"
    memory: 1Gi
    defaultTtl: 3600s
    maxTtl: 86400s
  runtimeDefaults:
    telemetry: &telemetry
      captureContent: false
      captureRawApiBodies: false
{% if langfuse_enabled %}
      traces:
        endpoint: http://langfuse-collector.{{ langfuse_namespace }}.svc.cluster.local:4317
        protocol: grpc
{% endif %}
    controlPlaneUrl: "http://{{ app_release_name }}-console.{{ agentos_namespace }}.svc.cluster.local:9091"
  telemetry: *telemetry
controller:
  env:
    - {name: KAGENT_MCP_DISCOVERY_URL, value: "http://{{ app_release_name }}-mcp-gateway.{{ agentos_namespace }}.svc.cluster.local:8080"}
    - {name: KAGENT_MCP_DISCOVERY_TOKEN_FILE, value: /var/run/kagent-mcp/token}
  volumes:
    - name: mcp-discovery
      projected:
        sources:
          - serviceAccountToken:
              path: token
              audience: agentos-mcp-discovery
              expirationSeconds: 3600
  volumeMounts:
    - {name: mcp-discovery, mountPath: /var/run/kagent-mcp, readOnly: true}
  imagePullSecrets: [{name: agentos-registry}]
  substrateClientCertificate:
    enabled: true
substrateWorkerPool:
  create: true
  replicas: 3
  sandboxClass: microvm
  workerImage: "{{ substrate_microvm_image }}"
  serviceAccount: {create: false, name: kagent-workers}
  template:
    nodeSelector:
      ate.dev/substrate-version: "v{{ substrate_version }}"
    resources:
      requests:
        cpu: 500m
        memory: 4Gi
      limits:
        cpu: "4"
        memory: 4Gi
ui:
  enabled: false
kmcp:
  enabled: false
kagent-tools:
  enabled: false
grafana-mcp:
  enabled: false
