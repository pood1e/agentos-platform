global:
  watchNamespaces: ["{{ agentos_namespace }}"{% if agentos_evaluation_enabled %}, "{{ agentos_evaluation_namespace }}"{% endif %}]
providers: null
database:
  postgres:
    readWriteConnectionStringSecretRef: {name: kagent-postgres, key: connectionString}
    ownerConnectionStringSecretRef: {name: kagent-postgres, key: connectionString}
config:
  harnessImages:
    release: "{{ kagent_version }}-agentos.1"
    kagent: "{{ harness_defaults.standard.workload.image | replace('registry.example.com/agentos', agentos_image_registry) }}"
    claude: "{{ harness_defaults.claude.workload.image | replace('registry.example.com/agentos', agentos_image_registry) }}"
    codex: "{{ harness_defaults.codex.workload.image | replace('registry.example.com/agentos', agentos_image_registry) }}"
  database:
    owner: {role: kagent_owner}
    readWrite: {role: kagent_owner}
    vectorEnabled: true
  sandboxes:
    guestImage: ghcr.io/kagent-dev/kagent/sandbox-guest@sha256:fb1218d5bdc397ecb514c5aa81d7958843635ca090c1419b191051f7bb01a3e2
    cpu: "1"
    memory: 1Gi
    defaultTtl: 3600s
    maxTtl: 86400s
  runtimeDefaults:
    telemetry: &telemetry
      captureContent: false
      captureRawApiBodies: false
{% if langfuse_enabled %}
      traces:
        endpoint: http://langfuse-collector.{{ langfuse_namespace }}.svc:4317
        protocol: grpc
{% endif %}
    controlPlaneUrl: "http://{{ app_release_name }}-console.{{ agentos_namespace }}.svc:9091"
  telemetry: *telemetry
controller:
  imagePullSecrets: [{name: agentos-registry}]
  substrateClientCertificate:
    enabled: true
substrateWorkerPool:
  create: true
  replicas: 3
  sandboxClass: microvm
  workerImage: "{{ substrate_microvm_image }}"
  template:
    serviceAccountName: kagent-workers
    nodeSelector:
      ate.dev/substrate-version: "v{{ substrate_version }}"
    resources:
      requests:
        cpu: 500m
        memory: 4Gi
      limits:
        cpu: "4"
        memory: 4Gi
ui:
  enabled: false
kmcp:
  enabled: false
kagent-tools:
  enabled: false
grafana-mcp:
  enabled: false
