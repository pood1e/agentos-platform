images:
  agentgateway: gsoci.azurecr.io/giantswarm/agentgateway-upstream/agentgateway:2.6.3@sha256:dbca0e92a69ba08a6ca28e471495df846ca35e55b9fbe91234187e17b6409a5a
postgres:
  readWriteConnectionStringSecretRef:
    name: substrate-postgres
    key: connectionString
  ownerConnectionStringSecretRef:
    name: substrate-postgres
    key: connectionString
  readWriteRole: kagent_owner
  ownerRole: kagent_owner
  schema: substrate
credentialProvider:
  namespacePolicies:
    - atespace: "{{ agentos_namespace }}"
      allowedNamespaces: ["{{ agentos_namespace }}"]
atelet:
  imageCredentialProviderBinDir: /var/lib/agentos/image-credential-provider/bin
  imageCredentialProviderConfigYAML: |
    apiVersion: kubelet.config.k8s.io/v1
    kind: CredentialProviderConfig
    providers:
      - name: busybox
        apiVersion: credentialprovider.kubelet.k8s.io/v1
        matchImages: ["{{ agentos_image_registry }}"]
        defaultCacheDuration: 0s
        args: [cat, /run/image-credentials/response.json]
  resources:
    requests:
      cpu: 500m
      memory: 2Gi
    limits:
      cpu: "4"
      memory: 8Gi
