mode: deployment
fullnameOverride: langfuse-collector
image:
  repository: otel/opentelemetry-collector-contrib
  tag: '{{ otel_collector_version }}@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6'
command: {name: otelcol-contrib}
presets:
  logsCollection: {enabled: false}
  kubernetesAttributes: {enabled: false}
extraEnvs:
  - name: LANGFUSE_AUTHORIZATION
    valueFrom: {secretKeyRef: {name: langfuse-otel, key: authorization}}
resources:
  requests: {cpu: 100m, memory: 128Mi}
  limits: {cpu: '1', memory: 512Mi}
ports:
  jaeger-compact: {enabled: false}
  jaeger-thrift: {enabled: false}
  jaeger-grpc: {enabled: false}
  zipkin: {enabled: false}
  metrics: {enabled: false}
config:
  receivers:
    jaeger: null
    zipkin: null
    prometheus: null
    otlp:
      protocols:
        grpc: {endpoint: '${env:MY_POD_IP}:4317'}
        http: {endpoint: '${env:MY_POD_IP}:4318'}
  processors:
    memory_limiter: {check_interval: 1s, limit_mib: 384, spike_limit_mib: 96}
    filter/span-events:
      error_mode: propagate
      trace_conditions:
        - context: spanevent
          conditions: ['true']
    transform/metadata:
      error_mode: propagate
      trace_statements:
        - context: resource
          statements:
            - keep_keys(attributes, ["service.name", "service.namespace", "service.version", "gen_ai.main_agent.id", "gen_ai.main_agent.name", "deployment.environment.name"])
        - context: span
          statements:
            - keep_keys(attributes, ["gen_ai.operation.name", "gen_ai.provider.name", "gen_ai.request.model", "gen_ai.response.model", "gen_ai.usage.input_tokens", "gen_ai.usage.output_tokens", "gen_ai.tool.name", "gen_ai.tool.call.id", "gen_ai.conversation.id", "a2a.task.id", "a2a.context.id", "kagent.task.id", "kagent.session.id", "http.response.status_code", "error.type"])
            - set(status.message, "")
    batch: {timeout: 5s, send_batch_size: 256}
  exporters:
    debug: null
    otlp_http/langfuse:
      endpoint: http://langfuse-web:3000/api/public/otel
      headers:
        Authorization: '${env:LANGFUSE_AUTHORIZATION}'
        x-langfuse-ingestion-version: '4'
      retry_on_failure: {enabled: true, max_elapsed_time: 300s}
      sending_queue: {enabled: true, queue_size: 2048}
  service:
    pipelines:
      logs: null
      metrics: null
      traces:
        receivers: [otlp]
        processors: [memory_limiter, filter/span-events, transform/metadata, batch]
        exporters: [otlp_http/langfuse]
