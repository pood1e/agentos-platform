# Native ate-idp-server deployment, based on the upstream Substrate chart.
apiVersion: v1
kind: ServiceAccount
metadata: {name: ate-idp-server, namespace: ate-system}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: ate-idp-server, namespace: ate-system}
spec:
  replicas: 2
  strategy:
    rollingUpdate: {maxUnavailable: 0, maxSurge: 1}
  selector:
    matchLabels: {app: ate-idp-server}
  template:
    metadata:
      labels: {app: ate-idp-server}
    spec:
      serviceAccountName: ate-idp-server
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: ate-idp-server
          image: {{ substrate_idp_image }}
          args:
            - --issuer=https://idp.ate-system.svc
            - --actor-id-jwt-pool=/run/actor-id-jwt-pool/pool.json
            - --server-cred-bundle=/run/servicedns.podcert.ate.dev/credential-bundle.pem
          ports: [{name: https, containerPort: 8443}]
          readinessProbe:
            httpGet: {path: /healthz, port: https, scheme: HTTPS}
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /healthz, port: https, scheme: HTTPS}
            periodSeconds: 10
          resources:
            requests: {cpu: 20m, memory: 32Mi}
            limits: {cpu: 200m, memory: 128Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: servicedns, mountPath: /run/servicedns.podcert.ate.dev, readOnly: true}
            - {name: pool, mountPath: /run/actor-id-jwt-pool, readOnly: true}
      volumes:
        - name: servicedns
          projected:
            sources:
              - podCertificate:
                  signerName: servicedns.podcert.ate.dev/identity
                  keyType: ECDSAP256
                  credentialBundlePath: credential-bundle.pem
        - name: pool
          secret:
            secretName: actor-id-jwt-pool
            items: [{key: pool, path: pool.json}]
---
apiVersion: v1
kind: Service
metadata: {name: idp, namespace: ate-system}
spec:
  selector: {app: ate-idp-server}
  ports: [{name: https, port: 443, targetPort: https, appProtocol: https}]
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata: {name: ate-idp-server, namespace: ate-system}
spec:
  maxUnavailable: 1
  selector:
    matchLabels: {app: ate-idp-server}
