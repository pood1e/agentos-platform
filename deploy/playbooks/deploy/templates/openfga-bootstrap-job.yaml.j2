apiVersion: batch/v1
kind: Job
metadata: {name: openfga-bootstrap, namespace: {{ agentos_namespace | to_json }}}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 540
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: {app.kubernetes.io/name: openfga-bootstrap}
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: fga
          image: {{ openfga_cli_image | to_json }}
          imagePullPolicy: IfNotPresent
          args: {{ (openfga_bootstrap_argv + ['--api-url=https://openfga.' + agentos_namespace + '.svc:8080', '--api-token=$(API_TOKEN)']) | to_json }}
          resources:
            requests: {cpu: 20m, memory: 64Mi}
            limits: {cpu: '1', memory: 256Mi}
          env:
            - name: API_TOKEN
              valueFrom: {secretKeyRef: {name: openfga-auth, key: keys}}
            - {name: SSL_CERT_FILE, value: /etc/openfga/ca/tls.crt}
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: ca, mountPath: /etc/openfga/ca, readOnly: true}
            - {name: input, mountPath: /etc/openfga/input, readOnly: true}
      volumes:
        - name: ca
          secret:
            secretName: openfga-ca
            items: [{key: tls.crt, path: tls.crt}]
        - name: input
          configMap: {name: openfga-bootstrap-input}
